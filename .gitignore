node_modules
.next
.DS_Store
*.tsbuildinfo

# Local secrets and machine-specific config.
# `.env*.local` rather than `.env*`, so .env.local.example stays tracked —
# the Vercel CLI appends the broader pattern on `vercel link`; don't keep it.
.env*.local
!.env.local.example

# Vercel CLI project linkage + pulled OIDC token.
.vercel

# Supabase CLI local state (generated by `supabase start`).
supabase/.temp/
supabase/.branches/

# Local agent state, including git worktrees created under .claude/worktrees.
# A worktree is a whole second copy of the tree, so anything walking the repo —
# knip, oxlint, tsc — otherwise sees every file twice.
.claude/

# Playwright signs in once and caches the session here. A session token
# is not something to keep in the repository, and it is regenerated on
# every run anyway.
.auth/

# Screenshots pasted into the terminal land in the working directory. The
# committed visual record lives under e2e/screenshots and is written there by
# the Playwright run, not dropped at the root.
Screenshot *.png
/test.png
/*.jpg
/*.jpeg
